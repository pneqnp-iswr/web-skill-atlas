index 0000000..acb0439
--- /dev/null
+++ b/desktop/tests/Qrafig.Desktop.Tests/XamlContractTests.cs
@@ -0,0 +1,279 @@
+using System.Text;
+using System.Text.RegularExpressions;
+
+namespace Qrafig.Desktop.Tests;
+
+/// <summary>
+/// The static half of ADR-0191, made executable.
+///
+/// ADR-0191 recorded that compiling markup is evidence about names and not about rendering, and that
+/// "where a class of defect can be caught statically, it now is". That pass was run by hand and left
+/// nothing behind, so the same defects came back: the tab-strip idiom it named as fixed in Employees
+/// was still wrong in Customers and Finance a slice later, and still wrong in Purchasing and
+/// Warehouse, which nobody had noticed at all.
+///
+/// These tests are that pass, written down. They are deliberately **file scanning, not WPF**: no
+/// PresentationCore reference, no dispatcher, no window, so they run in this headless suite on any
+/// platform. They cannot see layout, focus, clipping, virtualization or whether a command ever
+/// re-asks, which is why the live QRAFIG.exe smoke stays a gate rather than being replaced by them.
+/// What they can do is make a whole class of silent, run-time-only failure impossible to reintroduce.
+/// </summary>
+public sealed class XamlContractTests
+{
+    /// <summary>
+    /// Every `.xaml` in the shell project, read once, with XML comments blanked.
+    ///
+    /// Comments are blanked rather than removed so a reported line number still points at the right
+    /// line — and blanked at all because these files explain their own defects, and a comment quoting
+    /// the wrong idiom must not be read as the wrong idiom.
+    /// </summary>
+    private static readonly IReadOnlyList<XamlFile> Files = Load();
+
+    private sealed record XamlFile(string RelativePath, string Text)
+    {
+        public int LineOf(int offset) => Text.Take(offset).Count(c => c == '\n') + 1;
+        public string At(int offset) => $"{RelativePath}:{LineOf(offset)}";
+    }
+
+    private static IReadOnlyList<XamlFile> Load()
+    {
+        var root = RepositoryRoot();
+        var views = Path.Combine(root, "desktop", "src", "Qrafig.Desktop");
+
+        return [.. Directory
+            .EnumerateFiles(views, "*.xaml", SearchOption.AllDirectories)
+            .OrderBy(path => path, StringComparer.Ordinal)
+            .Select(path => new XamlFile(
+                Path.GetRelativePath(root, path).Replace('\\', '/'),
+                BlankComments(File.ReadAllText(path))))];
+    }
+
+    private static string RepositoryRoot()
+    {
+        var directory = new DirectoryInfo(AppContext.BaseDirectory);
+
+        while (directory is not null && !File.Exists(Path.Combine(directory.FullName, "Qrafig.sln")))
+            directory = directory.Parent;
+
+        return directory?.FullName
+            ?? throw new InvalidOperationException(
+                "Qrafig.sln was not found above the test assembly, so the XAML audit has nothing to read.");
+    }
+
+    /// <summary>Replaces the body of every XML comment with spaces and newlines of the same shape.</summary>
+    private static string BlankComments(string text)
+    {
+        var builder = new StringBuilder(text);
+
+        foreach (Match match in Regex.Matches(text, "<!--.*?-->", RegexOptions.Singleline))
+            for (var i = match.Index; i < match.Index + match.Length; i++)
+                if (builder[i] != '\n') builder[i] = ' ';
+
+        return builder.ToString();
+    }
+
+    private static string Report(string what, IEnumerable<string> findings)
+    {
+        var list = findings.ToArray();
+        return $"{what}{Environment.NewLine}  {string.Join(Environment.NewLine + "  ", list)}";
+    }
+
+    /// <summary>
+    /// The audit reads the views it is supposed to read.
+    ///
+    /// Every other test here passes trivially over an empty list, so a wrong path or a renamed folder
+    /// would turn the whole file green while auditing nothing. This is the test that fails instead.
+    /// </summary>
+    [Fact]
+    public void TheAuditReadsEveryViewAndDictionaryInTheShellProject()
+    {
+        Assert.NotEmpty(Files);
+
+        foreach (var expected in new[]
+                 {
+                     "desktop/src/Qrafig.Desktop/Views/ShellWindow.xaml",
+                     "desktop/src/Qrafig.Desktop/Views/EmployeesView.xaml",
+                     "desktop/src/Qrafig.Desktop/Theme/Controls.xaml",
+                     "desktop/src/Qrafig.Desktop/Theme/Tokens.Dark.xaml"
+                 })
+            Assert.Contains(expected, Files.Select(file => file.RelativePath));
+    }
+
+    /// <summary>
+    /// Every `StaticResource` key a view names is defined somewhere.
+    ///
+    /// BAML compiles without resolving the key. At run time the first missing one throws inside
+    /// `InitializeComponent()`, so the view's constructor never returns — and because navigation runs
+    /// through a `TwoWay` binding's source setter, the binding engine swallows the exception. The
+    /// sidebar highlights the workspace, the breadcrumb names it, and the previous one stays on
+    /// screen: no log line, no dialog, no crash. Three such keys shipped at once, each a
+    /// plausible-sounding neighbour of a real one.
+    /// </summary>
+    [Fact]
+    public void EveryStaticResourceKeyIsDefinedSomewhere()
+    {
+        var defined = Files
+            .SelectMany(file => Regex.Matches(file.Text, @"x:Key=""([^""]+)""")
+                .Select(match => match.Groups[1].Value))
+            .ToHashSet(StringComparer.Ordinal);
+
+        var missing = new List<string>();
+
+        foreach (var file in Files)
+            foreach (Match match in Regex.Matches(file.Text, @"\{StaticResource\s+([^}\s]+)\s*\}"))
+            {
+                var key = match.Groups[1].Value;
+
+                // A key coming from WPF's own dictionaries is not this repository's to define.
+                if (key.StartsWith("{x:", StringComparison.Ordinal) ||
+                    key.StartsWith("System", StringComparison.Ordinal)) continue;
+
+                if (!defined.Contains(key)) missing.Add($"{file.At(match.Index)}  {key}");
+            }
+
+        Assert.True(missing.Count == 0, Report("StaticResource keys that are defined nowhere:", missing));
+    }
+
+    /// <summary>
+    /// No control carries a keyed style whose `TargetType` names a different control.
+    ///
+    /// This throws at XAML load, with the same swallowed-exception consequence as a missing key:
+    /// `Placeholder.Panel` applied to a `Border` when it targets `StackPanel` left the shell showing
+    /// the previous workspace while the sidebar said Employees.
+    ///
+    /// `ElementStyle`, `HeaderStyle` and the other `…Style` properties on a `DataGrid` column target
+    /// the generated element rather than the column, so only a bare `Style=` is checked.
+    /// </summary>
+    [Fact]
+    public void NoControlCarriesAStyleWhoseTargetTypeNamesADifferentControl()
+    {
+        var keyed = new Dictionary<string, string>(StringComparer.Ordinal);
+
+        foreach (var file in Files)
+            foreach (Match match in Regex.Matches(file.Text, @"<Style\s+x:Key=""([^""]+)""\s+TargetType=""([^""]+)"""))
+                keyed[match.Groups[1].Value] = ShortTypeName(match.Groups[2].Value);
+
+        var wrong = new List<string>();
+
+        foreach (var file in Files)
+            foreach (Match match in Regex.Matches(
+                         file.Text, @"<([A-Za-z]\w*)\b[^<>]*?(?<![\w.])Style=""\{StaticResource\s+([^}\s]+)\s*\}"""))
+            {
+                var element = match.Groups[1].Value;
+                var key = match.Groups[2].Value;
+
+                if (keyed.TryGetValue(key, out var target) && target != element)
+                    wrong.Add($"{file.At(match.Index)}  <{element}> uses '{key}', whose TargetType is {target}");
+            }
+
+        Assert.True(wrong.Count == 0, Report("Styles applied to a control their TargetType does not name:", wrong));
+    }
+
+    /// <summary>
+    /// No property `Trigger` compares `Tag` against a boolean.
+    ///
+    /// `Tag` is typed `object`, so a bound `bool` arrives boxed and a property `Trigger` with
+    /// `Value="True"` compares it against the *string* `"True"`. It never matches, in every theme,
+    /// silently: the strip renders with nothing selected and only a live run shows it. Four
+    /// workspaces and twenty-seven buttons were wrong this way at once.
+    ///
+    /// A `Tag` genuinely holding a string — the native hover and press states `ShellWindow` mirrors
+    /// into it for Snap Layouts — is a different thing and is left alone.
+    /// </summary>
+    [Fact]
+    public void NoPropertyTriggerComparesTagAgainstABoolean()
+    {
+        var found = new List<string>();
+
+        foreach (var file in Files)
+            foreach (Match match in Regex.Matches(file.Text, @"<Trigger\s+Property=""Tag""\s+Value=""(True|False)"""))
+                found.Add($"{file.At(match.Index)}  Value=\"{match.Groups[1].Value}\"");
+
+        Assert.True(found.Count == 0, Report(
+            "Property Triggers on Tag that can never match — use "
+            + "<DataTrigger Binding=\"{Binding RelativeSource={RelativeSource Self}, Path=Tag}\">:", found));
+    }
+
+    /// <summary>
+    /// Every binding sharing an element with a `DataContext` override states its own source.
+    ///
+    /// `DataContext` re-points the element's other bindings at the child view model, silently. Five
+    /// Finance sections bound their `Visibility` to a property of the *workspace* on the same element
+    /// that handed the section to a child, so every one of them resolved against the child, failed,
+    /// and stayed visible: the sections rendered at once, stacked.
+    ///
+    /// The rule is structural on purpose. "Bind to a property the child happens to have" would be
+    /// correct in some cases and unenforceable in all of them; requiring an explicit
+    /// `RelativeSource`, `ElementName` or `Source` makes the intent readable and the audit exact.
+    /// </summary>
+    [Fact]
+    public void EveryBindingBesideADataContextOverrideStatesItsSource()
+    {
+        var shadowed = new List<string>();
+
+        foreach (var file in Files)
+            foreach (Match element in Regex.Matches(file.Text, @"<[A-Za-z][\w:.]*\s[^<>]*?/?>"))
+            {
+                if (!element.Value.Contains("DataContext=", StringComparison.Ordinal)) continue;
+
+                var unrooted = Regex.Matches(element.Value, @"(\w[\w.:]*)=""(\{Binding[^""]*)""")
+                    .Where(binding => binding.Groups[1].Value != "DataContext")
+                    .Where(binding => !StatesItsSource(binding.Groups[2].Value))
+                    .Select(binding => binding.Groups[1].Value)
+                    .Distinct(StringComparer.Ordinal)
+                    .ToArray();
+
+                if (unrooted.Length > 0)
+                    shadowed.Add($"{file.At(element.Index)}  DataContext set beside {string.Join(", ", unrooted)}");
+            }
+
+        Assert.True(shadowed.Count == 0, Report(
+            "Bindings shadowed by a DataContext override on the same element:", shadowed));
+    }
+
+    private static bool StatesItsSource(string binding) =>
+        binding.Contains("RelativeSource", StringComparison.Ordinal) ||
+        binding.Contains("ElementName", StringComparison.Ordinal) ||
+        binding.Contains("Source=", StringComparison.Ordinal);
+
+    /// <summary>
+    /// Every list control has a style, its own or an implicit one.
+    ///
+    /// A control the design system never styles renders in WPF's white default inside a dark window.
+    /// `ListView` and `ListBox` had no style at all once, so six Customers lists and the till's
+    /// customer results did exactly that.
+    /// </summary>
+    [Fact]
+    public void EveryListControlHasAStyleOrAnImplicitOne()
+    {
+        var implicitly_styled = Files
+            .SelectMany(file => Regex.Matches(file.Text, @"<Style\s+TargetType=""([^""]+)""")
+                .Select(match => ShortTypeName(match.Groups[1].Value)))
+            .ToHashSet(StringComparer.Ordinal);
+
+        var bare = new List<string>();
+
+        foreach (var file in Files)
+            foreach (Match match in Regex.Matches(
+                         file.Text, @"<(ListView|ListBox|DataGrid|TreeView|ComboBox)\b([^<>]*)>"))
+            {
+                var control = match.Groups[1].Value;
+
+                if (match.Groups[2].Value.Contains("Style=", StringComparison.Ordinal)) continue;
+                if (implicitly_styled.Contains(control)) continue;
+
+                bare.Add($"{file.At(match.Index)}  <{control}>");
+            }
+
+        Assert.True(bare.Count == 0, Report(
+            "List controls with neither a Style nor an implicit style, which render in WPF's default:", bare));
+    }
+
+    /// <summary>Turns `{x:Type ns:Thing}` or `ns:Thing` into `Thing`.</summary>
+    private static string ShortTypeName(string declared)
+    {
+        var trimmed = declared.Replace("{x:Type", string.Empty).Trim('{', '}', ' ');
+        var colon = trimmed.LastIndexOf(':');
+        return colon >= 0 ? trimmed[(colon + 1)..] : trimmed;
+    }
+}
